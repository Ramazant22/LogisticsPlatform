{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=LogisticsPlatformDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "LogisticsPlatform",
    "Audience": "LogisticsPlatformUsers"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  }
}
